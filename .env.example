# Copy to .env.local and set a hosted Postgres URL. .env.local is gitignored.
# Never use a VITE_ prefix for credentials, and never commit the real URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/club24?sslmode=require
# Optional separate database for pnpm test. The database name must end in _test.
DATABASE_TEST_URL=postgres://USER:PASSWORD@HOST:5432/club24_test?sslmode=require
